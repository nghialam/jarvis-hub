[Unit]
Description=Jarvis Hub 3.0 - Market Intelligence Portal
After=network.target ollama.service

[Service]
Type=simple
User=nghialam
WorkingDirectory=/Users/nghialam/jarvis-hub
ExecStart=/Users/nghialam/jarvis-hub/venv/bin/python app.py --host 0.0.0.0 --port 8100
Environment=JARVIS_ENV=prod
Environment=PATH=/Users/nghialam/jarvis-hub/venv/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
