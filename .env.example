# Sample environment file for production
# Copy to .env and fill in values
# shellcheck disable=SC2034

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string

# Application
JARVIS_ENV=prod
JARVIS_DB_PATH=/app/data/jarvis.db
PORT=8100

# LLM Provider
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# Telegram (optional, for cron delivery)
# JARVIS_TELEGRAM_BOT_TOKEN=xxx
# JARVIS_TELEGRAM_CHAT_ID=xxx

# CORS
# JARVIS_CORS_ORIGINS=https://yourdomain.com
